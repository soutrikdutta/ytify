{
  "headers": [
    {
      "source": "/ytify.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"ytify.apk\""
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/ytify.apk",
      "destination": "/ytify.apk"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
